extends layout

block content
  .container    
    if unauthorized
      .alert.alert-danger.text-center A personal locker is available to clients with a main balance of at least $1,000,000,000,000. In addition to saving money and confidential documents, owning a locker also allows you to contact a bank master for more features and benefits.
    else
      .row.justify-content-center
        .col-md-6
          .card#lockerPreview
            .card-body.text-center
              svg(id='lockerIcon', viewBox="0 0 640 640")
                path(d="M256 160L256 224L384 224L384 160C384 124.7 355.3 96 320 96C284.7 96 256 124.7 256 160zM192 224L192 160C192 89.3 249.3 32 320 32C390.7 32 448 89.3 448 160L448 224C483.3 224 512 252.7 512 288L512 512C512 547.3 483.3 576 448 576L192 576C156.7 576 128 547.3 128 512L128 288C128 252.7 156.7 224 192 224z")
              h5.mt-3 Locker Balance: $#{lockerBalance}

      if !isMaster
        a.btn-secondary.w-100(href='/master') Contact Master
      else
        if userMessage
          script(nonce=''+nonce).
            document.addEventListener('DOMContentLoaded', function() {
              document.body.innerHTML += `
                <div class="mt-3 mr-3 position-absolute top-0 end-0" aria-live="polite" aria-atomic="true">
                  <div id="notificationToast" class="toast">
                    <div class="toast-header">
                      <strong class="mr-3">Deposit Request</strong>
                      <small class="text-muted">just now</small>
                      <button type="button" class="ml-2 mb-1 close" data-dismiss="toast" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                      </button>
                    </div>
                    <div class="toast-body">
                      ${"!{userMessage}"}
                    </div>
                  </div>
                </div>
              `

              const toastEl = document.getElementById('notificationToast');
              const toast = new bootstrap.Toast(toastEl, {
                  animation: true, // Enable or disable animation
                  autohide: true,  // Automatically hide the toast
                  delay: 5000      // Delay in milliseconds before autohiding (if autohide is true)
              });

              // To show the toast
              toast.show();
            });
        h2.mt-4 Deposit to locker
        form(action='/master/deposit', method='POST')
          .form-group
            label(for='amount') Amount to Deposit
            input(type='number', name='amount', min='1', required)
          button.btn-primary.w-100#deposit_money(type='submit') Deposit
      h2.mt-4 Withdraw from locker
      form(action='/locker/withdraw', method='POST')
        .form-group
          label(for='amount') Amount to transfer to your account
          input(type='number', name='withdraw_amount', min='1', required)
        button.btn-primary.w-100(type='submit') Withdraw
      if successMessage
        .alert.alert-success.text-center.mt-3= successMessage
      if failMessage
        .alert.alert-danger.text-center.mt-3= failMessage

