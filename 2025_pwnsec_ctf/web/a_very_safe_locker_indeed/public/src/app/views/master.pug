extends layout

block content
  .container
    h2 Contact Master
    p Use the form below to request your master to visit your locker and deposit into it.
    form(action='', method='POST')
      .form-group
        label(for='amount') Amount to Deposit
        input(type='number', name='amount', min='1', required)
        label(for='userMessage') Message to Master
        textarea.form-control.w-100(name='userMessage', rows='4', placeholder='Enter your message here...', required) 
        input(type='hidden', name='email', value=''+clientEmail, required)
      button.btn-primary.w-100(type='submit') Deposit
    if successMessage
      .alert.alert-success.text-center.mt-3= successMessage
    if failMessage
      .alert.alert-danger.text-center.mt-3= failMessage

